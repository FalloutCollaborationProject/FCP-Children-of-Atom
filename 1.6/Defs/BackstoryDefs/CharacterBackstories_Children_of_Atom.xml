        <bodyTypeMale>Male</bodyTypeMale>
        <bodyTypeFemale>Female</bodyTypeFemale>
        <title>High Confessor of the Nucleus</title>
        <titleShort>high confessor</titleShort>
        <baseDesc>[PAWN_nameDef] was sent from Megaton to found a new congregation on the coast. [PAWN_pronoun] seized an old nuclear submarine, declared it the Nucleus, and now rules its faithful through fervor and fear of heresy.</baseDesc>
        <slot>Adulthood</slot>
        <spawnCategories>
            <li>FCP_Backstory_CoA_High_Confessor_Tektus</li>
        </spawnCategories>
        <skillGains>
            <Social>7</Social>
            <Shooting>5</Shooting>
            <Intellectual>4</Intellectual>
        </skillGains>
    </BackstoryDef>

