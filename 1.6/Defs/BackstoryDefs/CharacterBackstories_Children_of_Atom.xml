        <bodyTypeFemale>Female</bodyTypeFemale>
        <title>Capital Wasteland orphan</title>
        <titleShort>orphan</titleShort>
        <baseDesc>[PAWN_nameDef] was taken in by the Church of Atom as an orphan, fascinated from the start by the glow the other children feared.</baseDesc>
        <slot>Childhood</slot>
        <spawnCategories>
            <li>FCP_Character_Backstory_Tektus_Child</li>
        </spawnCategories>
