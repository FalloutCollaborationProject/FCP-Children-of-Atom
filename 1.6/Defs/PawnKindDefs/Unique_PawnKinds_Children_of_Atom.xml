<?xml version="1.0" encoding="utf-8"?>
<Defs>

    <!--__________ Unique Character Base __________-->

    <PawnKindDef Name="FCP_ChildrenOfAtom_UniqueCharacterBase" ParentName="FCP_ChildrenOfAtomkindBase" Abstract="true">
        <showInDebugSpawner>false</showInDebugSpawner>
        <apparelMoney>9999</apparelMoney>
        <gearHealthRange>10</gearHealthRange>
        <apparelAllowHeadgearChance>1</apparelAllowHeadgearChance>
        <apparelIgnoreSeasons>true</apparelIgnoreSeasons>
        <weaponMoney>9999</weaponMoney>
        <initialWillRange>4~8</initialWillRange>
        <initialResistanceRange>15~25</initialResistanceRange>
    </PawnKindDef>

    <!--__________ Church of Atom, Megaton (Fallout 3) __________-->

    <!-- Confessor Cromwell -->

    <PawnKindDef ParentName="FCP_ChildrenOfAtom_UniqueCharacterBase">
        <defName>FCP_Unique_Pawnkind_Confessor_Cromwell</defName>
        <label>Confessor Cromwell</label>
        <factionLeader>true</factionLeader>
        <combatPower>120</combatPower>
        <apparelRequired>
            <li>FCP_Apparel_Robes_of_Atom</li>
        </apparelRequired>
        <weaponTags>
            <li>FCP_Gamma_Gun</li>
        </weaponTags>
        <requiredWorkTags>
            <li>Violent</li>
        </requiredWorkTags>
        <backstoryFiltersOverride>
            <li>
                <categoriesChildhood>
                    <li>FCP_Character_Backstory_Cromwell_Child</li>
                </categoriesChildhood>
                <categoriesAdulthood>
                    <li>FCP_Backstory_CoA_Confessor_Cromwell</li>
