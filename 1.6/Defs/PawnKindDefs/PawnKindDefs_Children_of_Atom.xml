                    <countRange>1~3</countRange>
                </li>
                <li>
                    <thingDef MayRequire="Rick.FCP.NukaCola">FCP_Nuka_Cola</thingDef>
                    <countRange>1~2</countRange>
                </li>
                <li>
                    <thingDef MayRequire="Rick.FCP.WastelandFood">FCP_Food_Bug_Mush</thingDef>
                    <countRange>1~2</countRange>
                </li>
            </subOptionsChooseOne>
        </inventoryOptions>
    </PawnKindDef>

    <!-- Radiant Merchant -->
    
