<?xml version="1.0" encoding="utf-8" ?>
<Defs>

    <!--__________ Children of Atom Rank Expeditions __________-->

    <!-- Loot -->

    <ThingSetMakerDef>
        <defName>FCP_CoAExpeditionLootMaker</defName>
        <root Class="ThingSetMaker_MarketValue">
            <fixedParams>
                <filter>
                    <thingDefs>
                        <li>FCP_Currency_Caps</li>
                        <li>Steel</li>
                        <li>Uranium</li>
                        <li>MedicineHerbal</li>
                    </thingDefs>
                </filter>
            </fixedParams>
        </root>
    </ThingSetMakerDef>

    <!-- Novice -->

    <FCP.Ranks.RankExpeditionDef>
        <defName>FCP_Expedition_CoA_Novice</defName>
        <label>pilgrimage to the Glow</label>
        <description>A short journey to a nearby crater to pray, scavenge, and remind any squatters whose ground they're standing on.</description>
        <durationDays>3~5</durationDays>
        <xpReward>
            <Shooting>200</Shooting>
        </xpReward>
        <lootMaker>FCP_CoAExpeditionLootMaker</lootMaker>
        <lootMarketValueRange>50~150</lootMarketValueRange>
        <siteRevealChance>0.15</siteRevealChance>
        <failureChance>0.12</failureChance>
        <returnFlavorKeys>
            <li>FCP_Rank_Expedition_CoA_Novice_1</li>
            <li>FCP_Rank_Expedition_CoA_Novice_2</li>
            <li>FCP_Rank_Expedition_CoA_Novice_3</li>
            <li>FCP_Rank_Expedition_CoA_Novice_4</li>
        </returnFlavorKeys>
    </FCP.Ranks.RankExpeditionDef>

    <!-- Veteran -->

    <FCP.Ranks.RankExpeditionDef>
        <defName>FCP_Expedition_CoA_Veteran</defName>
        <label>cleansing of unbelievers</label>
        <description>A tasked mission to drive off a settlement that fears the Glow, or to bring their conversion, whichever comes first.</description>
        <durationDays>6~8</durationDays>
        <xpReward>
            <Shooting>400</Shooting>
            <Social>100</Social>
        </xpReward>
        <lootMaker>FCP_CoAExpeditionLootMaker</lootMaker>
        <lootMarketValueRange>150~350</lootMarketValueRange>
        <siteRevealChance>0.25</siteRevealChance>
        <failureChance>0.1</failureChance>
        <returnFlavorKeys>
            <li>FCP_Rank_Expedition_CoA_Veteran_1</li>
            <li>FCP_Rank_Expedition_CoA_Veteran_2</li>
            <li>FCP_Rank_Expedition_CoA_Veteran_3</li>
            <li>FCP_Rank_Expedition_CoA_Veteran_4</li>
        </returnFlavorKeys>
    </FCP.Ranks.RankExpeditionDef>

    <!-- Elite -->

    <FCP.Ranks.RankExpeditionDef>
        <defName>FCP_Expedition_CoA_Elite</defName>
        <label>the Deep Glow</label>
        <description>A solo journey into a crater too hot for anyone else to survive, the kind of pilgrimage only a Grand Zealot or Elder Confessor is trusted to make alone.</description>
        <durationDays>8~10</durationDays>
        <xpReward>
            <Shooting>600</Shooting>
            <Social>150</Social>
        </xpReward>
        <lootMaker>FCP_CoAExpeditionLootMaker</lootMaker>
        <lootMarketValueRange>300~600</lootMarketValueRange>
        <siteRevealChance>0.35</siteRevealChance>
        <failureChance>0.08</failureChance>
        <returnFlavorKeys>
            <li>FCP_Rank_Expedition_CoA_Elite_1</li>
            <li>FCP_Rank_Expedition_CoA_Elite_2</li>
            <li>FCP_Rank_Expedition_CoA_Elite_3</li>
            <li>FCP_Rank_Expedition_CoA_Elite_4</li>
        </returnFlavorKeys>
    </FCP.Ranks.RankExpeditionDef>

    <!-- Sentinel -->

    <FCP.Ranks.RankExpeditionDef>
        <defName>FCP_Expedition_CoA_Sentinel</defName>
        <label>the High Confessor's crusade</label>
        <description>A long-range mission carried out in the High Confessor's own name, the kind that decides whether a new crater kneels to Atom or is left to the unbelievers.</description>
        <durationDays>10~14</durationDays>
        <xpReward>
            <Shooting>800</Shooting>
            <Social>200</Social>
        </xpReward>
        <lootMaker>FCP_CoAExpeditionLootMaker</lootMaker>
        <lootMarketValueRange>500~900</lootMarketValueRange>
        <siteRevealChance>0.5</siteRevealChance>
        <failureChance>0.05</failureChance>
        <returnFlavorKeys>
            <li>FCP_Rank_Expedition_CoA_Sentinel_1</li>
            <li>FCP_Rank_Expedition_CoA_Sentinel_2</li>
            <li>FCP_Rank_Expedition_CoA_Sentinel_3</li>
            <li>FCP_Rank_Expedition_CoA_Sentinel_4</li>
        </returnFlavorKeys>
    </FCP.Ranks.RankExpeditionDef>

</Defs>
