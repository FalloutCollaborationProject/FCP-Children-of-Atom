<?xml version="1.0" encoding="utf-8"?>
<Defs>

	<!--__________ Factions __________-->

	<!-- Children of Atom -->

	<FactionDef ParentName="FactionBase">
		<defName>FCP_Faction_Children_of_Atom</defName>
		<label>Children of Atom</label>
		<description>The Children of Atom are a zealous religious cult that worships radiation and atomic energy as divine gifts. They believe that exposure to radiation brings them closer to their god, Atom, and that through the power of Division - nuclear fission - they will achieve transcendence. Their faithful bear radiation scars proudly, and some have become "Glowing Ones," their bodies suffused with lethal radioactivity. They make their homes in irradiated craters and ruined facilities, viewing the wasteland's most dangerous zones as holy ground. Though seen as fanatics by many, the Children of Atom are devoted, organized, and surprisingly welcoming to those who embrace their faith.</description>
		<colorSpectrum>
			<li>(1, 1, 1)</li>
		</colorSpectrum>
		<maxConfigurableAtWorldCreation>9999</maxConfigurableAtWorldCreation>
		<pawnSingular>Child of Atom</pawnSingular>
		<pawnsPlural>Children of Atom</pawnsPlural>
		<categoryTag>Outlander</categoryTag>
		<settlementGenerationWeight>0.5</settlementGenerationWeight>
		<requiredCountAtGameStart>1</requiredCountAtGameStart>
		<canSiege>true</canSiege>
		<canStageAttacks>true</canStageAttacks>
		<leaderTitle>high confessor</leaderTitle>
		<fixedLeaderKinds>
			<li>FCP_Pawnkind_Children_of_Atom_High_Confessor</li>
		</fixedLeaderKinds>
		<factionIconPath>World_Icon/FCP_Children_of_Atom_World_Icon</factionIconPath>
		<techLevel>Industrial</techLevel>
		<allowedCultures>
			<li>FCP_Culture_Children_of_Atom</li>
		</allowedCultures>

		<!--__________ Ideology __________-->

		<fixedIdeo>true</fixedIdeo>
		<ideoName>Church of Atom</ideoName>
		<ideoDescription>Atom is the source of all creation and destruction. Through radiation, we are purified. Through Division, we are united. The Glow is sacred. Those who fear the atom's touch are blind to its divine truth.</ideoDescription>
		<forcedMemes>
			<!-- Structure -->
			<li MayRequire="Ludeon.RimWorld.Ideology">Structure_Ideological</li>
			<!-- Memes -->
			<li MayRequire="Ludeon.RimWorld.Ideology">FCP_Meme_Children_of_Atom_Faith</li>
			<li MayRequire="Ludeon.RimWorld.Ideology">FCP_Meme_Children_of_Atom_Division</li>
		</forcedMemes>
		<requiredPreceptsOnly>true</requiredPreceptsOnly>
		<disallowedPrecepts>
			<li MayRequire="Ludeon.RimWorld.Ideology">DrugUse_MedicalOnly</li>
			<li MayRequire="Ludeon.RimWorld.Ideology">DrugUse_Prohibited</li>
		</disallowedPrecepts>
		<disallowedMemes>
			<li MayRequire="Ludeon.RimWorld.Ideology">Nudism</li>
			<li MayRequire="Ludeon.RimWorld.Ideology">Blindsight</li>
		</disallowedMemes>

		<!--__________ Biotech __________-->

		<xenotypeSet>
			<xenotypeChances>
				<Neanderthal MayRequire="Ludeon.RimWorld.Biotech">0</Neanderthal>
				<Hussar MayRequire="Ludeon.RimWorld.Biotech">0</Hussar>
				<Pigskin MayRequire="Ludeon.RimWorld.Biotech">0</Pigskin>
				<Yttakin MayRequire="Ludeon.RimWorld.Biotech">0</Yttakin>
				<Genie MayRequire="Ludeon.RimWorld.Biotech">0</Genie>
				<Dirtmole MayRequire="Ludeon.RimWorld.Biotech">0</Dirtmole>
				<Highmate MayRequire="Ludeon.RimWorld.Biotech">0</Highmate>
			</xenotypeChances>
		</xenotypeSet>

		<!--__________ Backstories __________-->

		<backstoryFilters>
			<li>
				<categories>
					<li>FCP_Children_of_Atom</li>
                    <li>FCP_Children_of_Atom_Child</li>
				</categories>
			</li>
		</backstoryFilters>

		<caravanTraderKinds>
			<li>Caravan_Outlander_BulkGoods</li>
			<li>Caravan_Outlander_CombatSupplier</li>
			<li>Caravan_Outlander_Exotic</li>
		</caravanTraderKinds>
		<visitorTraderKinds>
			<li>Visitor_Outlander_Standard</li>
		</visitorTraderKinds>
		<baseTraderKinds>
			<li>Base_Outlander_Standard</li>
		</baseTraderKinds>
		<allowedArrivalTemperatureRange>-40~45</allowedArrivalTemperatureRange>
		<maxPawnCostPerTotalPointsCurve>
			<points>
				<li>(0,35)</li>
				<li>(70, 50)</li>
				<li>(700, 100)</li>
				<li>(1300, 150)</li>
				<li>(100000, 10000)</li>
			</points>
		</maxPawnCostPerTotalPointsCurve>
		<pawnGroupMakers>
			<li>
				<!-- Normal fights, standard mix -->
				<kindDef>Combat</kindDef>
				<options>
					<FCP_Pawnkind_Children_of_Atom_Glowing_Sentinel>10</FCP_Pawnkind_Children_of_Atom_Glowing_Sentinel>
					<FCP_Pawnkind_Children_of_Atom_Worker>5</FCP_Pawnkind_Children_of_Atom_Worker>
					<FCP_Pawnkind_Children_of_Atom_High_Confessor>1</FCP_Pawnkind_Children_of_Atom_High_Confessor>
				</options>
			</li>
			<li>
				<kindDef>Peaceful</kindDef>
				<options>
					<FCP_Pawnkind_Children_of_Atom_Worker>10</FCP_Pawnkind_Children_of_Atom_Worker>
					<FCP_Pawnkind_Children_of_Atom_Glowing_Sentinel>3</FCP_Pawnkind_Children_of_Atom_Glowing_Sentinel>
					<FCP_Pawnkind_Children_of_Atom_High_Confessor>1</FCP_Pawnkind_Children_of_Atom_High_Confessor>
				</options>
			</li>
			<li>
				<kindDef>Trader</kindDef>
				<traders>
					<FCP_Pawnkind_Children_of_Atom_Merchant>1</FCP_Pawnkind_Children_of_Atom_Merchant>
				</traders>
				<carriers>
					<Muffalo>6</Muffalo>
					<Dromedary>5</Dromedary>
				</carriers>
				<guards>
					<FCP_Pawnkind_Children_of_Atom_Worker>7</FCP_Pawnkind_Children_of_Atom_Worker>
					<FCP_Pawnkind_Children_of_Atom_Glowing_Sentinel>3</FCP_Pawnkind_Children_of_Atom_Glowing_Sentinel>
				</guards>
			</li>
			<li>
				<kindDef>Settlement</kindDef>
				<options>
					<FCP_Pawnkind_Children_of_Atom_Worker>10</FCP_Pawnkind_Children_of_Atom_Worker>
					<FCP_Pawnkind_Children_of_Atom_Glowing_Sentinel>5</FCP_Pawnkind_Children_of_Atom_Glowing_Sentinel>
					<FCP_Pawnkind_Children_of_Atom_High_Confessor>1</FCP_Pawnkind_Children_of_Atom_High_Confessor>
				</options>
			</li>
		</pawnGroupMakers>
		<settlementTexturePath>World/WorldObjects/DefaultSettlement</settlementTexturePath>
		<naturalEnemy>false</naturalEnemy>
		<permanentEnemy>false</permanentEnemy>
		<goodwillDailyGain>0.10</goodwillDailyGain>
		<goodwillDailyFall>0.10</goodwillDailyFall>
	</FactionDef>

</Defs>