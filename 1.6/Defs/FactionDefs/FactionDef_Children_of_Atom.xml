<?xml version="1.0" encoding="utf-8"?>
<Defs>

	<!--__________ Factions __________-->

	<!-- Children of Atom -->

	<FactionDef ParentName="FactionBase">
		<defName>FCP_Faction_Children_of_Atom</defName>
		<label>Children of Atom</label>
		<description>The Children of Atom are a zealous religious cult that worships radiation and atomic energy as divine gifts. They believe that exposure to radiation brings them closer to their god, Atom, and that through the power of Division - nuclear fission - they will achieve transcendence. Their faithful bear radiation scars proudly, and some have become "Glowing Ones," their bodies suffused with lethal radioactivity. They make their homes in irradiated craters and ruined facilities, viewing the wasteland's most dangerous zones as holy ground. Though seen as fanatics by many, the Children of Atom are devoted, organized, and surprisingly welcoming to those who embrace their faith.</description>
		<basicMemberKind>FCP_Pawnkind_Children_of_Atom_Worker</basicMemberKind>
		<colorSpectrum>
			<li>(1, 1, 1)</li>
		</colorSpectrum>
		<maxConfigurableAtWorldCreation>5</maxConfigurableAtWorldCreation>
		<factionNameMaker>FCP_NamerFaction_Children_of_Atom</factionNameMaker>
		<settlementNameMaker>FCP_NamerSettlement_Children_of_Atom</settlementNameMaker>
		<pawnSingular>Child of Atom</pawnSingular>
		<pawnsPlural>Children of Atom</pawnsPlural>
		<categoryTag>Outlander</categoryTag>
		<settlementGenerationWeight>0.15</settlementGenerationWeight>
		<requiredCountAtGameStart>1</requiredCountAtGameStart>
		<canSiege>true</canSiege>
		<canStageAttacks>true</canStageAttacks>
		<leaderTitle>high confessor</leaderTitle>
		<fixedLeaderKinds>
			<li>FCP_Pawnkind_Children_of_Atom_High_Confessor</li>
			<li>FCP_Pawnkind_Confessors_Flock_Elder_Confessor</li>
		</fixedLeaderKinds>
		<factionIconPath>World_Icon/Children_of_Atom_Icon/FCP_Children_of_Atom_World_Icon</factionIconPath>
		<techLevel>Industrial</techLevel>
		<allowedCultures>
			<li>FCP_Culture_Children_of_Atom</li>
		</allowedCultures>

		<!--__________ Ideology __________-->

		<fixedIdeo>true</fixedIdeo>
		<ideoName>Church of Atom</ideoName>
		<ideoDescription>Atom is the source of all creation and destruction. Through radiation, we are purified. Through Division, we are united. The Glow is sacred. Those who fear the atom's touch are blind to its divine truth.</ideoDescription>
		<forcedMemes>
			<!-- Structure -->
			<li MayRequire="Ludeon.RimWorld.Ideology">FCP_Structure_Children_of_Atom</li>
			<!-- Memes -->
			<li MayRequire="Ludeon.RimWorld.Ideology">FCP_Meme_Children_of_Atom_Faith</li>
			<li MayRequire="Ludeon.RimWorld.Ideology">FCP_Meme_Children_of_Atom_Division</li>
		</forcedMemes>
		<requiredPreceptsOnly>true</requiredPreceptsOnly>
		<disallowedPrecepts>
			<li MayRequire="Ludeon.RimWorld.Ideology">DrugUse_MedicalOnly</li>
			<li MayRequire="Ludeon.RimWorld.Ideology">DrugUse_Prohibited</li>
		</disallowedPrecepts>
		<disallowedMemes>
			<li MayRequire="Ludeon.RimWorld.Ideology">Nudism</li>
			<li MayRequire="Ludeon.RimWorld.Ideology">Blindsight</li>
		</disallowedMemes>

		<!--__________ Biotech __________-->

		<xenotypeSet>
			<xenotypeChances>
				<Neanderthal MayRequire="Ludeon.RimWorld.Biotech">0</Neanderthal>
				<Hussar MayRequire="Ludeon.RimWorld.Biotech">0</Hussar>
				<Pigskin MayRequire="Ludeon.RimWorld.Biotech">0</Pigskin>
				<Yttakin MayRequire="Ludeon.RimWorld.Biotech">0</Yttakin>
				<Genie MayRequire="Ludeon.RimWorld.Biotech">0</Genie>
				<Dirtmole MayRequire="Ludeon.RimWorld.Biotech">0</Dirtmole>
				<Highmate MayRequire="Ludeon.RimWorld.Biotech">0</Highmate>
			</xenotypeChances>
		</xenotypeSet>

		<!--__________ Backstories __________-->

		<backstoryFilters>
			<li>
				<categories>
					<li>FCP_Children_of_Atom</li>
					<li>FCP_Children_of_Atom_Child</li>
					<li>FCP_Confessors_Flock</li>
					<li>FCP_Confessors_Flock_Child</li>
				</categories>
			</li>
		</backstoryFilters>

		<!--__________ Kinds __________-->

		<caravanTraderKinds>
			<li>Caravan_Outlander_BulkGoods</li>
			<li>Caravan_Outlander_CombatSupplier</li>
			<li>Caravan_Outlander_Exotic</li>
			<li>FCP_Caravan_Confessors_Flock</li>
		</caravanTraderKinds>
		<visitorTraderKinds>
			<li>Visitor_Outlander_Standard</li>
		</visitorTraderKinds>
		<baseTraderKinds>
			<li>Base_Outlander_Standard</li>
		</baseTraderKinds>
		<allowedArrivalTemperatureRange>-40~45</allowedArrivalTemperatureRange>
		<maxPawnCostPerTotalPointsCurve>
			<points>
				<li>(0,35)</li>
				<li>(70, 50)</li>
				<li>(700, 100)</li>
				<li>(1300, 150)</li>
				<li>(100000, 10000)</li>
			</points>
		</maxPawnCostPerTotalPointsCurve>
		<!--__________ Group Makers __________-->

		<pawnGroupMakers>

			<!-- Nucleus Zealot Guard -->

			<li Class="FCP.Core.GroupMakerWithCustomChar">
				<!-- Richter's rank-and-file enforcers -->
				<kindDef>Combat</kindDef>
				<disallowedStrategies>
					<li>EmergeFromWater</li>
				</disallowedStrategies>
				<options>
					<FCP_Pawnkind_Children_of_Atom_Glowing_Sentinel>10</FCP_Pawnkind_Children_of_Atom_Glowing_Sentinel>
					<FCP_Pawnkind_Children_of_Atom_Worker>5</FCP_Pawnkind_Children_of_Atom_Worker>
					<FCP_Pawnkind_Confessors_Flock_Sentinel>8</FCP_Pawnkind_Confessors_Flock_Sentinel>
					<FCP_Pawnkind_Confessors_Flock_Technician>5</FCP_Pawnkind_Confessors_Flock_Technician>
				</options>
				<characterDefs>
					<li>FCP_Character_CoA_Grand_Zealot_Richter</li>
					<li>FCP_Character_CoA_Zealot_Ware</li>
					<li>FCP_Character_CoA_Zealot_Theil</li>
					<li>FCP_Character_CoA_Sister_Harper</li>
				</characterDefs>
				<characterChance>0.30</characterChance>
			</li>

			<!-- High Confessor's Escort -->

			<li Class="FCP.Core.GroupMakerWithCustomChar">
				<!-- Tektus rarely leaves the Nucleus himself -->
				<kindDef>Combat</kindDef>
				<disallowedStrategies>
					<li>EmergeFromWater</li>
				</disallowedStrategies>
				<options>
					<FCP_Pawnkind_Children_of_Atom_Glowing_Sentinel>6</FCP_Pawnkind_Children_of_Atom_Glowing_Sentinel>
					<FCP_Pawnkind_Confessors_Flock_Sentinel>4</FCP_Pawnkind_Confessors_Flock_Sentinel>
				</options>
				<characterDefs>
					<li>FCP_Character_CoA_High_Confessor_Tektus</li>
				</characterDefs>
				<characterChance>0.15</characterChance>
			</li>

			<!-- Nucleus Congregation -->

			<li Class="FCP.Core.GroupMakerWithCustomChar">
				<kindDef>Peaceful</kindDef>
				<options>
					<FCP_Pawnkind_Children_of_Atom_Worker>10</FCP_Pawnkind_Children_of_Atom_Worker>
					<FCP_Pawnkind_Children_of_Atom_Glowing_Sentinel>3</FCP_Pawnkind_Children_of_Atom_Glowing_Sentinel>
					<FCP_Pawnkind_Confessors_Flock_Technician>12</FCP_Pawnkind_Confessors_Flock_Technician>
					<FCP_Pawnkind_Confessors_Flock_Sentinel>3</FCP_Pawnkind_Confessors_Flock_Sentinel>
				</options>
				<characterDefs>
					<li>FCP_Character_CoA_Brother_Devin</li>
					<li>FCP_Character_CoA_Sister_Aubert</li>
					<li>FCP_Character_CoA_Brother_Alders</li>
					<li>FCP_Character_CoA_The_Archemist</li>
				</characterDefs>
				<characterChance>0.20</characterChance>
			</li>

			<!-- Church of Atom Pilgrimage -->

			<li Class="FCP.Core.GroupMakerWithCustomChar">
				<!-- Cromwell and Maya travel out from Megaton only rarely; the church itself is not a Children of Atom settlement -->
				<kindDef>Peaceful</kindDef>
				<options>
					<FCP_Pawnkind_Children_of_Atom_Worker>10</FCP_Pawnkind_Children_of_Atom_Worker>
					<FCP_Pawnkind_Children_of_Atom_High_Confessor>1</FCP_Pawnkind_Children_of_Atom_High_Confessor>
				</options>
				<characterDefs>
					<li>FCP_Character_CoA_Confessor_Cromwell</li>
					<li>FCP_Character_CoA_Mother_Maya</li>
				</characterDefs>
				<characterChance>0.10</characterChance>
			</li>

			<!-- Radiant Merchant -->

			<li Class="FCP.Core.GroupMakerWithTraderKind">
				<kindDef>Trader</kindDef>
				<traderKinds>
					<li>Caravan_Outlander_BulkGoods</li>
					<li>Caravan_Outlander_Exotic</li>
				</traderKinds>
				<traders>
					<FCP_Pawnkind_Children_of_Atom_Merchant>1</FCP_Pawnkind_Children_of_Atom_Merchant>
				</traders>
				<carriers>
					<Muffalo>6</Muffalo>
					<Dromedary>5</Dromedary>
				</carriers>
				<guards>
					<FCP_Pawnkind_Children_of_Atom_Worker>7</FCP_Pawnkind_Children_of_Atom_Worker>
					<FCP_Pawnkind_Children_of_Atom_Glowing_Sentinel>3</FCP_Pawnkind_Children_of_Atom_Glowing_Sentinel>
				</guards>
				<characterDefs>
					<li>FCP_Character_CoA_Brother_Kane</li>
					<li>FCP_Character_CoA_Sister_Mai</li>
				</characterDefs>
				<characterTraderKinds>
					<li>
						<key>FCP_Character_CoA_Brother_Kane</key>
						<value>FCP_Trader_CoA_Kane_Arms</value>
					</li>
					<li>
						<key>FCP_Character_CoA_Sister_Mai</key>
						<value>FCP_Trader_CoA_Mai_Goods</value>
					</li>
				</characterTraderKinds>
				<characterChance>0.30</characterChance>
			</li>

			<!-- Confessor's Merchant -->

			<li Class="FCP.Core.GroupMakerWithTraderKind">
				<kindDef>Trader</kindDef>
				<traderKinds>
					<li>FCP_Caravan_Confessors_Flock</li>
					<li>Caravan_Outlander_BulkGoods</li>
				</traderKinds>
				<traders>
					<FCP_Pawnkind_Confessors_Flock_Merchant>1</FCP_Pawnkind_Confessors_Flock_Merchant>
				</traders>
				<carriers>
					<Muffalo>6</Muffalo>
					<Dromedary>5</Dromedary>
				</carriers>
				<guards>
					<FCP_Pawnkind_Confessors_Flock_Technician>5</FCP_Pawnkind_Confessors_Flock_Technician>
					<FCP_Pawnkind_Confessors_Flock_Sentinel>3</FCP_Pawnkind_Confessors_Flock_Sentinel>
				</guards>
			</li>

			<!-- Settlement -->

			<li>
				<kindDef>Settlement</kindDef>
				<options>
					<FCP_Pawnkind_Children_of_Atom_Worker>10</FCP_Pawnkind_Children_of_Atom_Worker>
					<FCP_Pawnkind_Children_of_Atom_Glowing_Sentinel>5</FCP_Pawnkind_Children_of_Atom_Glowing_Sentinel>
					<FCP_Pawnkind_Children_of_Atom_High_Confessor>1</FCP_Pawnkind_Children_of_Atom_High_Confessor>
					<FCP_Pawnkind_Confessors_Flock_Technician>10</FCP_Pawnkind_Confessors_Flock_Technician>
					<FCP_Pawnkind_Confessors_Flock_Sentinel>4</FCP_Pawnkind_Confessors_Flock_Sentinel>
					<FCP_Pawnkind_Confessors_Flock_Elder_Confessor>1</FCP_Pawnkind_Confessors_Flock_Elder_Confessor>
				</options>
			</li>
		</pawnGroupMakers>
		<settlementTexturePath>World/WorldObjects/DefaultSettlement</settlementTexturePath>
		<naturalEnemy>false</naturalEnemy>
		<permanentEnemy>false</permanentEnemy>
		<modExtensions>
			<!-- Faction tab label -->
			<li Class="FCP.Factions.FactionExtension_FlavorOverride">
				<newLabel>Atom's Faithful</newLabel>
			</li>
			<!-- Walk in as pilgrims, no drop pods -->
			<li Class="FCP.Factions.FactionExtension_BannedArrivalModes">
				<arrivalModes>
					<li>EdgeDrop</li>
					<li>EdgeDropGroups</li>
					<li>CenterDrop</li>
					<li>RandomDrop</li>
				</arrivalModes>
			</li>
			<!-- Ideology settings -->
			<li Class="FCP.Factions.FactionExtension_FixedIdeo" MayRequire="Ludeon.RimWorld.Ideology">
				<ideoIconDef>FCP_Icon_Children_of_Atom</ideoIconDef>
				<ideoColorDef>Green</ideoColorDef>
				<memberName>Child of Atom</memberName>
				<adjective>Atomist</adjective>
				<roleOverrides>
					<li>
						<preceptDef>IdeoRole_Leader</preceptDef>
						<newName>High Confessor</newName>
						<disableApparelRequirements>true</disableApparelRequirements>
					</li>
					<li>
						<preceptDef>IdeoRole_Moralist</preceptDef>
						<newName>Confessor</newName>
						<disableApparelRequirements>true</disableApparelRequirements>
					</li>
				</roleOverrides>
			</li>
			<!-- Enlistment stuff -->
			<li Class="FCP.Enlist.FactionEnlistOptions">
				<enlistOptionsDefs>
					<li>FCP_Enlistment_ChildrenOfAtom</li>
				</enlistOptionsDefs>
				<ignoreAutoAssignedDefs>true</ignoreAutoAssignedDefs>
			</li>
			<!-- Named settlement: the Nucleus, Tektus and Richter's stronghold -->
			<li Class="FCP.Factions.FactionExtension_SettlementControl">
				<namedSettlements>
					<li>
						<name>The Nucleus</name>
						<traders>
							<li>
								<traderName>Kane's Arms</traderName>
								<traderKind>FCP_Trader_CoA_Kane_Arms</traderKind>
							</li>
							<li>
								<traderName>Sister Mai's Stores</traderName>
								<traderKind>FCP_Trader_CoA_Mai_Goods</traderKind>
							</li>
						</traders>
					</li>
				</namedSettlements>
			</li>
		</modExtensions>
	</FactionDef>

</Defs>
