<?xml version="1.0" encoding="utf-8" ?>
<Defs>

    <!--__________ Children of Atom Titles __________-->

    <!-- Worker -->

    <RoyalTitleDef ParentName="FCP_Base_Empire_Titles">
        <defName>FCP_Title_ChildrenOfAtom_Worker</defName>
        <label>faithful worker</label>
        <description>The newest of the faithful, given over to labor in service of the Nucleus while they learn the mysteries of Atom.</description>
        <tags>
            <li>FCP_Title_ChildrenOfAtom</li>
        </tags>
        <seniority>0</seniority>
        <favorCost>1</favorCost>
        <changeHeirQuestPoints>1000</changeHeirQuestPoints>
        <allowDignifiedMeditationFocus>False</allowDignifiedMeditationFocus>
        <awardWorkerClass>RoyalTitleAwardWorker_Instant</awardWorkerClass>
        <requiredApparel>
            <li>
                <bodyPartGroupsMatchAny>
                    <li>Torso</li>
                </bodyPartGroupsMatchAny>
                <requiredTags>
                    <li>FCP_Children_of_Atom_Worker</li>
                </requiredTags>
            </li>
        </requiredApparel>
        <permitPointsAwarded>1</permitPointsAwarded>
    </RoyalTitleDef>

