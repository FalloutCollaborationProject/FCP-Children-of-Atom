<?xml version="1.0" encoding="utf-8" ?>
<Defs>

    <!--__________ Kingsport Lighthouse Settlement Traders __________-->

    <!-- The Beacon of Atom -->

    <TraderKindDef>
        <defName>FCP_Trader_CoA_Kingsport_Beacon</defName>
        <label>The Beacon of Atom</label>
        <stockGenerators>

            <!-- Resources -->
            <li Class="StockGenerator_SingleDef">
                <thingDef>Silver</thingDef>
                <countRange>500~1200</countRange>
            </li>
            <li Class="StockGenerator_SingleDef">
                <thingDef>Steel</thingDef>
                <countRange>80~200</countRange>
            </li>
            <li Class="StockGenerator_SingleDef">
                <thingDef>ComponentIndustrial</thingDef>
                <countRange>5~15</countRange>
            </li>

            <!-- Radiation Weapons (the lighthouse's defenders carry gamma weapons) -->
            <li Class="StockGenerator_MultiDef">
                <thingDefs>
                    <li>FCP_Gun_Gamma</li>
                    <li>FCP_Gun_Radium_Rifle</li>
                </thingDefs>
                <countRange>1~3</countRange>
            </li>

            <!-- Zealot Armor -->
            <li Class="StockGenerator_SingleDef">
                <thingDef>FCP_Apparel_Zealot_Armor</thingDef>
                <countRange>1~2</countRange>
            </li>

            <!-- Ballistic Weapons -->
            <li Class="StockGenerator_MultiDef" MayRequire="Rick.FCP.BallisticWeapons">
                <thingDefs>
                    <li>FCP_Gun_10mm_Pistol</li>
                    <li>FCP_Gun_SawnOff_Shotgun</li>
                    <li>FCP_Gun_32_Hunting_Rifle</li>
                </thingDefs>
                <countRange>2~4</countRange>
            </li>

            <!-- Melee Weapons -->
            <li Class="StockGenerator_MultiDef" MayRequire="Rick.FCP.MeleeWeapons">
                <thingDefs>
                    <li>FCP_Melee_Rebar_Club</li>
                    <li>FCP_Melee_Sledgehammer</li>
                </thingDefs>
                <countRange>1~3</countRange>
            </li>

            <!-- The Blessed's Remedies (radiation runs heavy so close to the glowing one) -->
            <li Class="StockGenerator_MultiDef" MayRequire="Rick.FCP.Chems">
                <thingDefs>
                    <li>FCP_Chem_RadX</li>
                    <li>FCP_Chem_Radaway</li>
                    <li>FCP_Chem_MedX</li>
                </thingDefs>
                <countRange>15~35</countRange>
            </li>

            <!-- Vanilla Weapons -->
            <li Class="StockGenerator_MarketValue">
                <tradeTag>WeaponRanged</tradeTag>
                <countRange>1~3</countRange>
            </li>

            <!-- Buying -->
            <li Class="StockGenerator_BuyExpensiveSimple" />
            <li Class="StockGenerator_BuyTradeTag">
                <tag>WeaponRanged</tag>
            </li>
            <li Class="StockGenerator_BuyTradeTag">
                <tag>Armor</tag>
            </li>

        </stockGenerators>
    </TraderKindDef>

</Defs>
