<?xml version="1.0" encoding="utf-8" ?>
<Defs>

    <!--__________ Crater of Atom Settlement Traders __________-->

    <!-- Sister Gwyneth's Shrine -->

    <TraderKindDef>
        <defName>FCP_Trader_CoA_Gwyneth_Shrine</defName>
        <label>Gwyneth's Shrine</label>
        <stockGenerators>

            <!-- Resources -->
            <li Class="StockGenerator_SingleDef">
                <thingDef>Silver</thingDef>
                <countRange>700~1600</countRange>
            </li>
            <li Class="StockGenerator_SingleDef">
                <thingDef>MedicineIndustrial</thingDef>
                <countRange>5~15</countRange>
            </li>

            <!-- Confessors Flock Apparel -->
            <li Class="StockGenerator_SingleDef">
                <thingDef>FCP_Apparel_Confessors_Flock_Coat</thingDef>
                <countRange>1~3</countRange>
            </li>
            <li Class="StockGenerator_SingleDef">
                <thingDef>FCP_Apparel_Confessors_Flock_Helm</thingDef>
                <countRange>1~3</countRange>
            </li>
            <li Class="StockGenerator_SingleDef">
                <thingDef>FCP_Apparel_Inquisitor_Cowl</thingDef>
                <countRange>0~2</countRange>
            </li>

            <!-- Basic Medical Chems -->
            <li Class="StockGenerator_MultiDef" MayRequire="Rick.FCP.Chems">
                <thingDefs>
                    <li>FCP_Chem_Stimpak</li>
                    <li>FCP_Chem_RadX</li>
                    <li>FCP_Chem_Radaway</li>
                </thingDefs>
                <countRange>10~25</countRange>
            </li>

            <!-- Food -->
            <li Class="StockGenerator_Category">
                <categoryDef>Foods</categoryDef>
                <thingDefCountRange>2~4</thingDefCountRange>
                <totalPriceRange>200~500</totalPriceRange>
            </li>

            <!-- Buying -->
            <li Class="StockGenerator_BuyExpensiveSimple" />
            <li Class="StockGenerator_Category">
                <categoryDef>Medicine</categoryDef>
            </li>

        </stockGenerators>
    </TraderKindDef>

    <!-- The Archemist's Cache -->

    <TraderKindDef>
        <defName>FCP_Trader_CoA_Archemist_Cache</defName>
        <label>Archemist's Cache</label>
        <stockGenerators>

            <!-- Resources -->
            <li Class="StockGenerator_SingleDef">
                <thingDef>Silver</thingDef>
                <countRange>900~2000</countRange>
            </li>
            <li Class="StockGenerator_SingleDef">
                <thingDef>Steel</thingDef>
                <countRange>100~300</countRange>
            </li>
            <li Class="StockGenerator_SingleDef">
                <thingDef>ComponentIndustrial</thingDef>
                <countRange>10~30</countRange>
            </li>
            <li Class="StockGenerator_SingleDef">
                <thingDef>Uranium</thingDef>
                <countRange>10~30</countRange>
            </li>

            <!-- Radiation Weapons -->
            <li Class="StockGenerator_MultiDef">
                <thingDefs>
                    <li>FCP_Gun_Gamma</li>
                    <li>FCP_Gun_Radium_Rifle</li>
                </thingDefs>
                <countRange>1~3</countRange>
            </li>

            <!-- Ballistic Weapons -->
            <li Class="StockGenerator_MultiDef" MayRequire="Rick.FCP.BallisticWeapons">
                <thingDefs>
                    <li>FCP_Gun_10mm_Pistol</li>
                    <li>FCP_Gun_32_Hunting_Rifle</li>
                </thingDefs>
                <countRange>2~4</countRange>
            </li>

            <!-- Melee Weapons -->
            <li Class="StockGenerator_MultiDef" MayRequire="Rick.FCP.MeleeWeapons">
                <thingDefs>
                    <li>FCP_Melee_Rebar_Club</li>
                    <li>FCP_Melee_Ripper</li>
                </thingDefs>
                <countRange>2~4</countRange>
            </li>

            <!-- Buying -->
            <li Class="StockGenerator_BuyExpensiveSimple" />
            <li Class="StockGenerator_BuyTradeTag">
                <tag>WeaponRanged</tag>
            </li>
            <li Class="StockGenerator_BuyTradeTag">
                <tag>Armor</tag>
            </li>

        </stockGenerators>
    </TraderKindDef>

</Defs>
