<?xml version="1.0" encoding="utf-8" ?>
<Defs>

    <!-- Site: Heretics at the Vigil -->

    <SitePartDef>
        <defName>FCP_Site_CoA_Heretic_Vigil</defName>
        <label>defiled vigil</label>
        <description>Heretics occupying a glow vigil sacred to the Division.</description>
        <workerClass>SitePartWorker_Outpost</workerClass>
        <siteTexture>World/WorldObjects/DefaultSettlement</siteTexture>
        <expandingIconTexture>MapIcons/Sites/FCP_Old_North_Church_Site</expandingIconTexture>
        <forceExitAndRemoveMapCountdownDurationDays>6</forceExitAndRemoveMapCountdownDurationDays>
        <requiresFaction>true</requiresFaction>
        <wantsThreatPoints>true</wantsThreatPoints>
        <tags>
            <li>FCP_Site_CoA_Heretic_Vigil</li>
        </tags>
    </SitePartDef>

    <GenStepDef>
        <defName>FCP_Site_CoA_Heretic_Vigil_Outpost</defName>
        <linkWithSite>FCP_Site_CoA_Heretic_Vigil</linkWithSite>
        <order>450</order>
        <genStep Class="GenStep_Outpost"/>
    </GenStepDef>

    <GenStepDef>
        <defName>FCP_Site_CoA_Heretic_Vigil_Power</defName>
        <linkWithSite>FCP_Site_CoA_Heretic_Vigil</linkWithSite>
        <order>451</order>
        <genStep Class="GenStep_Power"/>
    </GenStepDef>

